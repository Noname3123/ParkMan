# ---------- MinIO ----------
MINIO_ENDPOINT=http://minio:9901
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
BUCKET_CAMERA=camera-images-parking-lot-6953dda6f0f2d22e951cabdb ##TODO: change bucket names here,
BUCKET_EDIT=edited-images

# ---------- Redis ----------
REDIS_HOST=redis_parking_spots_status
REDIS_PORT=6379

# ---------- Kafka ----------
KAFKA_BOOTSTRAP=kafka:29092
TOPIC=cctv-image-events

# ---------- YOLOServer (remote) ----------
YOLO_ENDPOINT=http://yolo_server:8000/predict

# ---------- Mongo Manager DB ----------
MONGO_MANAGER_DATABASE_R_ONLY_URI=mongodb://external:external_pass@mongo_manager_db_service:27017/ParkMan_manager_db

# ---------- Car Counter ----------
CAR_COUNTER_URL=http://car-counter:5001/process

# ---------- Image Fetcher ----------
# If 0, sleep 1 hour (default)
# >0, sleep X seconds (testing)
FETCH_INTERVAL_SECONDS=60

# ---------- Image Processor ----------
CROP_ENABLED=true
CROP_MODE=bottom_percent
CROP_BOTTOM_PERCENT=0.32