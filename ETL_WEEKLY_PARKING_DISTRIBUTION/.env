MONGO_MANAGER_DATABASE_R_ONLY_URI=mongodb://external:external_pass@mongo_manager_db_service:27017/ParkMan_manager_db

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=parkman_user
CLICKHOUSE_PASS=parkman_user_pass

CH_SOURCE_HOST=clickhouse
CH_SOURCE_PORT=8123
CH_SOURCE_USER=parkman_user
CH_SOURCE_PASS=parkman_user_pass
CH_SOURCE_DB=parking_db

CH_BASELINE_HOST=clickhouse
CH_BASELINE_PORT=8123
CH_BASELINE_USER=parkman_user
CH_BASELINE_PASS=parkman_user_pass
CH_BASELINE_DB=parking_db

PARKING_LOT_NAME=Zagreb City Center Garage
PARKING_LOT_NAME_REGEX=false

# scheduler
RUN_ONCE=false
SCHEDULE_WEEKDAY=monday
SCHEDULE_TIME=00:05
PROMETHEUS_PORT=9396
USE_UTC=true
TZ_OFFSET_HOURS=0

# thresholds
ABS_DIFF_THRESHOLD=4.0
REL_DIFF_THRESHOLD=0.50
USE_ZSCORE=true
ZSCORE_THRESHOLD=5.0

PYTHONUNBUFFERED=1

SIMULATION_MODE=true
