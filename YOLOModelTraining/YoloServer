    "# prompt:  expose web server (fast API), serving YOLO model from cell above. The model counts cars with get_target_class_count and returns the number of cars\n",
    "\n",
    "!pip install fastapi nest_asyncio pyngrok uvicorn python-multipart\n",
    "\n",
    "from fastapi import FastAPI, UploadFile, File\n",
    "import uvicorn\n",
    "import nest_asyncio\n",
    "from pyngrok import ngrok\n",
    "import numpy as np\n",
    "from PIL import Image\n",
    "import io\n",
    "\n",
    "app = FastAPI()\n",
    "\n",
    "#import model here\n",
    "\n",
    "\n",
    "###\n",
    "\n",
    "\n",
    "\n",
    "# This function counts the number of detected objects of a specific class\n",
    "# within the results of a YOLO inference.\n",
    "def get_target_class_count(results, target_class_name):\n",
    "\n",
    "\n",
    "    # counter for the target class\n",
    "    target_class_count = 0\n",
    "\n",
    "    # Iterate through the detected objects in the results\n",
    "    for box in results[0].boxes:\n",
    "        # Access the class ID for the current detection\n",
    "        class_id = int(box.cls[0])\n",
    "\n",
    "        # Access the class name from the model's class names list\n",
    "        # model.names is a dictionary mapping class IDs to class names\n",
    "        detected_class_name = model.names[class_id]\n",
    "\n",
    "        # Check if the detected class name matches the target class name\n",
    "        if detected_class_name == target_class_name:\n",
    "            target_class_count += 1\n",
    "\n",
    "    return target_class_count\n",
    "\n",
    "@app.post(\"/count_cars/\")\n",
    "async def count_cars_endpoint(file: UploadFile = File(...)):\n",
    "    \"\"\"\n",
    "    Receives an image file, performs YOLO inference to count cars,\n",
    "    and returns the number of detected cars.\n",
    "    \"\"\"\n",
    "    try:\n",
    "      # Read the image file\n",
    "      image_data = await file.read()\n",
    "      image = Image.open(io.BytesIO(image_data))\n",
    "\n",
    "      # Perform inference on the uploaded image\n",
    "      # model is loaded in the setup code\n",
    "      results = model(image)\n",
    "\n",
